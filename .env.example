# Used by docker-compose (all values have defaults, copy to .env to override)
POSTGRES_USER=phonebook
POSTGRES_PASSWORD=phonebook
POSTGRES_DB=phonebook

# Used when running the binaries locally (outside Docker)
DATABASE_URL=postgres://phonebook:phonebook@localhost:5432/phonebook?sslmode=disable
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=phonebook.contacts
KAFKA_GROUP_ID=phonebook-audit
HTTP_ADDR=:8080
LOG_LEVEL=info
